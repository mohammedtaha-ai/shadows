+#[tokio::test]
+async fn a_fork_is_resumed_before_it_is_answered() {
+    let (_h, c, _ev) = open_fake().await;
+    let src = c
+        .start_session(&tmp(), SessionStart::New)
+        .await
+        .unwrap()
+        .session_id;
+    let fork = c
+        .start_session(&tmp(), SessionStart::Fork(src.clone()))
+        .await
+        .unwrap();
