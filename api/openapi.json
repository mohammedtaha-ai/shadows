{
  "components": {
    "schemas": {
      "Actor": {
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "id"
        ],
        "type": "object"
      },
      "CreateDir": {
        "properties": {
          "name": {
            "description": "One new path component that Windows would accept.",
            "type": "string"
          },
          "parent": {
            "description": "Absolute path to an existing directory.",
            "type": "string"
          }
        },
        "required": [
          "parent",
          "name"
        ],
        "type": "object"
      },
      "CreateProject": {
        "properties": {
          "command_id": {
            "description": "The idempotency key (spec §3.2). The same id with the same request\nreplays the first answer; with a different one it is a conflict.",
            "type": "string"
          },
          "directory": {
            "description": "Absolute path to an existing directory, in any spelling; it is stored\nand returned canonical.",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "command_id",
          "slug",
          "name",
          "directory"
        ],
        "type": "object"
      },
      "CreateThread": {
        "properties": {
          "command_id": {
            "description": "The idempotency key (spec §3.2), scoped to the project.",
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "command_id",
          "title"
        ],
        "type": "object"
      },
      "DirectoryEntry": {
        "description": "One directory a person could open or choose.",
        "properties": {
          "hidden": {
            "description": "Hidden or system on Windows, or named with a leading dot. Flagged rather\nthan filtered, so the client decides what to show and nothing is\nwithheld without anyone saying so.",
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "description": "Absolute and canonical; sending it back names exactly this directory.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "path",
          "hidden"
        ],
        "type": "object"
      },
      "DirectoryListing": {
        "description": "A directory's immediate subdirectories, or the roots when `path` is `None`.",
        "properties": {
          "entries": {
            "description": "Sorted case-insensitively by name, which is how a person scans a list\nof folders; ties are broken by the exact name so the order is total.",
            "items": {
              "$ref": "#/components/schemas/DirectoryEntry"
            },
            "type": "array"
          },
          "parent": {
            "description": "Where \"up\" leads. `None` at a root, and for the roots themselves.",
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "description": "The directory listed, canonical. `None` for the roots.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "entries"
        ],
        "type": "object"
      },
      "EntryRef": {
        "oneOf": [
          {
            "description": "Typed, because `operation/` exists. The three below reference entities\nwhose modules Milestone 0 never creates, and §4.1's rule is that no module\nis created before the task that fills it.",
            "properties": {
              "Operation": {
                "$ref": "#/components/schemas/OperationId",
                "description": "Typed, because `operation/` exists. The three below reference entities\nwhose modules Milestone 0 never creates, and §4.1's rule is that no module\nis created before the task that fills it."
              }
            },
            "required": [
              "Operation"
            ],
            "type": "object"
          },
          {
            "properties": {
              "Decision": {
                "type": "string"
              }
            },
            "required": [
              "Decision"
            ],
            "type": "object"
          },
          {
            "properties": {
              "Research": {
                "type": "string"
              }
            },
            "required": [
              "Research"
            ],
            "type": "object"
          },
          {
            "properties": {
              "Workflow": {
                "type": "string"
              }
            },
            "required": [
              "Workflow"
            ],
            "type": "object"
          }
        ]
      },
      "ErrorBody": {
        "description": "The body of every error this API answers with itself: the stable code a\nclient matches on (spec §3.4), and a human message nobody should match on.\nA request axum rejects before a handler runs (malformed JSON, a missing\nquery parameter) is answered by axum in plain text, not with this.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "description": "Stable codes clients pattern-match on. Never match on human text.\nSpec §3.4. `Blocked`/`Rejected` are domain outcomes and never appear here.",
        "enum": [
          "PROCESS_SPAWN_FAILED",
          "PROCESS_TERMINATED",
          "STORAGE_UNAVAILABLE",
          "STORAGE_MIGRATION_FAILED",
          "STORAGE_CONSTRAINT_VIOLATION",
          "COMMAND_CONFLICT",
          "IDEMPOTENCY_KEY_REQUIRED",
          "INVALID_COMMAND",
          "INVALID_CURSOR",
          "AGENT_AUTH_FAILED",
          "AGENT_UNSUPPORTED_PROFILE",
          "PATH_INVALID",
          "PATH_NOT_FOUND",
          "PATH_NOT_A_DIRECTORY",
          "PATH_ACCESS_DENIED",
          "PATH_ALREADY_EXISTS",
          "PATH_UNAVAILABLE"
        ],
        "type": "string"
      },
      "Operation": {
        "description": "Spec §2.7, §6.14. `thread_id` stays a plain `String` here on purpose: the\n`ProjectId`/`ThreadId`/`ThreadEntryId` sweep is a separate change, staged\nfor reviewability, that follows this task (spec §4.1 OPEN block).",
        "properties": {
          "cancel_requested_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string"
          },
          "failure_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "failure_stage": {
            "type": [
              "string",
              "null"
            ]
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "$ref": "#/components/schemas/OperationId"
          },
          "interrupt_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": "string"
          },
          "outcome_json": {
            "type": [
              "string",
              "null"
            ]
          },
          "runtime_instance_id": {
            "$ref": "#/components/schemas/RuntimeInstanceId"
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "status_kind": {
            "type": "string"
          },
          "thread_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "status_kind",
          "runtime_instance_id",
          "created_at"
        ],
        "type": "object"
      },
      "OperationId": {
        "format": "uuid",
        "type": "string"
      },
      "PlanningThread": {
        "properties": {
          "created_at": {
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/ThreadId"
          },
          "project_id": {
            "$ref": "#/components/schemas/ProjectId"
          },
          "status": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "project_id",
          "title",
          "status",
          "created_at"
        ],
        "type": "object"
      },
      "Project": {
        "properties": {
          "created_at": {
            "type": "string"
          },
          "directory": {
            "description": "Spec §4.2: the directory this project's turns run in, as\n[`ProjectDirectory`] resolved it. `None` only for a project created\nbefore projects owned one (`migrations/0003_project_directory.sql`);\na turn on such a project fails at Prepare rather than running in the\ndaemon's own working directory.",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "$ref": "#/components/schemas/ProjectId"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "created_at"
        ],
        "type": "object"
      },
      "ProjectId": {
        "format": "uuid",
        "type": "string"
      },
      "RuntimeInstanceId": {
        "format": "uuid",
        "type": "string"
      },
      "StartTurn": {
        "properties": {
          "prompt": {
            "type": "string"
          }
        },
        "required": [
          "prompt"
        ],
        "type": "object"
      },
      "ThreadEntry": {
        "properties": {
          "author": {
            "$ref": "#/components/schemas/Actor",
            "description": "Spec §4.2 calls this field's type `Principal`. Milestone 0 uses\n`events::Actor`, which already has exactly this shape (`kind` + `id`) and\nalready answers \"who did this\" for durable events. Declaring a second\nidentical struct would record one decision twice, which this project's\ndocumentation rules forbid. See the note in §4.2."
          },
          "body": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/ThreadEntryId"
          },
          "kind": {
            "type": "string"
          },
          "ordinal": {
            "format": "int64",
            "type": "integer"
          },
          "refs": {
            "items": {
              "$ref": "#/components/schemas/EntryRef"
            },
            "type": "array"
          },
          "thread_id": {
            "$ref": "#/components/schemas/ThreadId"
          }
        },
        "required": [
          "id",
          "thread_id",
          "ordinal",
          "kind",
          "author",
          "body",
          "refs",
          "created_at"
        ],
        "type": "object"
      },
      "ThreadEntryId": {
        "format": "uuid",
        "type": "string"
      },
      "ThreadId": {
        "format": "uuid",
        "type": "string"
      },
      "TurnStarted": {
        "properties": {
          "operation_id": {
            "$ref": "#/components/schemas/OperationId"
          }
        },
        "required": [
          "operation_id"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "The local daemon's HTTP API. Every client is on another origin; only origins passed with `--allow-origin` may call it. There is no authentication: the daemon binds to loopback (spec §1, OPEN block on remote access). Errors answered by the API carry `ErrorBody`, whose `code` is stable; a request axum rejects before a handler runs (malformed JSON, a missing parameter) is answered in plain text.",
    "license": {
      "name": ""
    },
    "title": "shadows",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/fs/dirs": {
      "get": {
        "description": "Exposes the machine's directory names to any client the CORS list admits;\nsee spec §1's OPEN block on remote access.",
        "operationId": "list_dirs",
        "parameters": [
          {
            "description": "Absolute path to list. Absent or empty: the roots to start from.",
            "in": "query",
            "name": "path",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirectoryListing"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "PATH_INVALID, PATH_NOT_A_DIRECTORY"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "PATH_ACCESS_DENIED"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "PATH_NOT_FOUND"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "PATH_UNAVAILABLE"
          }
        },
        "summary": "A directory's immediate subdirectories, or the roots to start from.",
        "tags": [
          "filesystem"
        ]
      },
      "post": {
        "operationId": "create_dir",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDir"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirectoryEntry"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "PATH_INVALID, PATH_NOT_A_DIRECTORY"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "PATH_ACCESS_DENIED"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "PATH_NOT_FOUND: no such parent"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "PATH_ALREADY_EXISTS"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "PATH_UNAVAILABLE"
          }
        },
        "summary": "Creates one new directory to choose as a project's.",
        "tags": [
          "filesystem"
        ]
      }
    },
