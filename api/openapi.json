    "/api/operations/{id}/stop": {
      "post": {
        "operationId": "stop_turn",
        "parameters": [
          {
            "description": "The turn's operation",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/OperationId"
