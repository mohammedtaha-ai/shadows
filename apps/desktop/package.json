{
  "name": "nylra-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --test \"tests/*.test.*\"",
    "test:companion:browser": "playwright test",
    "test:companion:unit": "node --test tests/companion/model.test.ts tests/companion/geometry.test.ts tests/companion/scheduler.test.ts tests/companion/messages.test.ts tests/companion/contracts.test.ts tests/companion/native-state.test.ts tests/companion/desktop-gesture.test.ts",
    "test:companion:production": "node --test tests/companion/production.test.ts",
    "build:desktop": "node scripts/build-desktop.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "yaml": "2.9.1"
  }
}
