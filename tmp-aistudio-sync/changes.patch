+  const done = render()
+  typeInto(field('MCP name'), 'tools')
+  if (type === 'stdio') {
+    const select = document.querySelector<HTMLSelectElement>('[aria-label="MCP transport"]')!
+    act(() => { select.value = 'stdio'; select.dispatchEvent(new Event('change', { bubbles: true })) })
